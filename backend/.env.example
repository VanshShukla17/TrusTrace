# Tip Autopsy Backend Environment Example (server-side only)
APP_ENV=development
NODE_ENV=development
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL (TrustTrace project: https://vevrmjlokngcknkidmbc.supabase.co)
SUPABASE_URL=https://vevrmjlokngcknkidmbc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=

# Optional bounded multimodal/LLM parser (disabled | gemini | groq; leave disabled for deterministic-only mode)
LLM_PROVIDER=disabled
LLM_API_KEY=

# Optional Sarvam voice readout (Phase 3)
SARVAM_API_KEY=

# Phase 4: Zero-cost real-time NSE/BSE market feed (Yahoo Finance v8 + snapshot fallback)
LIVE_MARKET_ENABLED=true
LIVE_MARKET_CACHE_TTL_MS=45000

# Phase 4: Real-time YouTube Atom RSS / WebSub monitor & WhatsApp alerts
YOUTUBE_MONITOR_ENABLED=true
YOUTUBE_POLL_INTERVAL_MS=180000
WHATSAPP_PROVIDER=dry_run
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
SUBSCRIPTION_ENCRYPTION_KEY=replace-with-32-byte-hex-secret
INTERNAL_CRON_SECRET=

# Operational limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
REQUEST_TIMEOUT_MS=15000
